{
  "profilePanel": {
    "type": "Panel",
    "props": {
      "title": "User Profile",
      "description": "Manage your personal info",
      "variant": "main"
    },
    "children": {
      "nameField": {
        "type": "Input",
        "props": {
          "label": "Full Name",
          "description": "Enter your legal name"
        }
      },
      "bioField": {
        "type": "Textarea",
        "props": {
          "label": "About You",
          "description": "A short bio"
        }
      },
      "preferencesPanel": {
        "type": "Panel",
        "props": {
          "title": "Preferences",
          "description": "Set your preferences"
        },
        "children": {
          "themeSelect": {
            "type": "Select",
            "props": {
              "label": "Theme",
              "description": "Choose your theme",
              "options": [
                { "value": "light", "label": "Light" },
                { "value": "dark", "label": "Dark" }
              ]
            }
          },
          "notifications": {
            "type": "ToggleSwitch",
            "props": {
              "label": "Enable Notifications",
              "description": "Receive app updates"
            }
          }
        }
      },
      "submitButton": {
        "type": "Button",
        "props": {
          "label": "Save Changes"
        },
        "emits": {
          "onClick": "profileSaved"
        }
      },
      "confirmation": {
        "type": "Triggered",
        "triggeredBy": "profileSaved",
        "children": {
          "type": "Panel",
          "props": {
            "title": "All Done!",
            "description": "Your profile has been saved."
          }
        }
      }
    }
  }
}
